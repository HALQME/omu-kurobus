---
import PassKeySignup from "@/components/auth/passkey-signup";
import PasskeySignin from "@/components/auth/passkey-signin";
import SignOut from "@/components/auth/signout";

import { isPasskeySignup } from "./_is_passkey_signup";
const session = () => {
    if (Astro.locals.session) {
        return Astro.locals.session;
    } else {
        return null;
    }
};
const isAuthenticated = () => {
    return !!session();
};
const isPasskey = async () => {
    if (!isAuthenticated()) {
        return false;
    }
    const userId = session()?.userId;
    if (userId === undefined || userId === null || userId === "") {
        return false;
    }
    return await isPasskeySignup(userId);
};
---

<div
    class="p-3 rounded-lg shadow-sm max-w-md bg-white dark:bg-gray-800 border border-gray-100 dark:border-gray-700"
>
    {(await isPasskey()) ? (
    <div
        class="flex items-center p-3 bg-green-50 dark:bg-green-900/20 border border-green-100 dark:border-green-700 rounded-md"
    >
        <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-5 w-5 text-green-500 dark:text-green-400 mr-2"
            viewBox="0 0 20 20"
            fill="currentColor"
        >
            <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"></path>
        </svg>
        <p class="text-sm font-medium text-green-700 dark:text-green-300">
            パスキーでサインイン済みです。
        </p>
    </div>
    <p class="text-sm text-gray-500 dark:text-gray-400 mt-2">
            ユーザーID:
        {session()?.userId}
    </p>
    <section aria-label="logout" class="mt-4">
        <SignOut client:only="react"/>
    </section>

    ) : (
    <PasskeySignin client:only="react" />
    <PassKeySignup client:only="react" />
    )}
</div>
