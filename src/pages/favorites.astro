---
import Layout from "@/layouts/layout.astro";
import Favos from "@/src/components/favos-list";

const session = () => {
    if (Astro.locals.session) {
        return Astro.locals.session;
    } else {
        return null;
    }
};
const userId = session() ? session()!.userId : null;
---

<Layout title="Favorites">
    <title slot="title">ハム大クロバス | お気に入り</title>
    <meta
        name="description"
        content="お気に入り登録した授業の一覧です"
        slot="description"
    />
    <h2
        class="text-xl font-bold mb-2 text-gray-800 dark:text-gray-200 border-l-4 border-blue-500 pl-2"
    >
        お気に入り授業
    </h2>
    <div class="text-gray-600 dark:text-gray-400 mb-4">
        お気に入り登録した授業の一覧です。
        <br />
        <span>* 通常、お気に入り登録した授業は、端末間で同期されません。 </span>
    </div>

    <details class="max-w-md my-8">
        <summary
            class="text-xl font-bold text-gray-800 dark:text-gray-200 mb-4 pb-2 border-b border-primary-500 cursor-pointer"
        >
            関連メニュー
        </summary>
        <div class="space-y-2">
            <a href="/timetable" class="block">
                <button
                    class="w-full bg-blue-500 hover:bg-blue-600 text-white font-bold py-2 px-4 rounded"
                >
                    時間割表
                </button>
            </a>
            <a href="/account" class="block">
                <button
                    class="w-full bg-blue-500 hover:bg-blue-600 text-white font-bold py-2 px-4 rounded"
                >
                    アカウント
                </button>
            </a>
        </div>
    </details>

    {
        !userId ? (
            <div class="text-center my-8">
                <p class="text-gray-600 dark:text-gray-400">
                    お気に入りの授業がありません。
                </p>
            </div>
        ) : (
            <Favos userId={userId} client:only="react" />
        )
    }
</Layout>
